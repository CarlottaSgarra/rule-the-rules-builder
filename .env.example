# PostHog analytics (https://posthog.com)
# Project Settings -> Project API Key / Project API Host in your PostHog account.
# Set these as real values in Vercel (Project Settings -> Environment Variables),
# and/or in a local ".env.local" file (gitignored) for local dev. Never commit
# real values to this file.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Gate per /registrazioni (password condivisa, nessun database).
# Questi NON hanno prefisso VITE_: restano solo lato server, mai nel bundle
# del browser. Su Vercel vanno marcati "Sensitive" (sono segreti veri).
#
# REGISTRAZIONI_PASSWORD: la password che mandi via email a chi ha comprato.
# SESSION_SECRET: stringa casuale di almeno 32 caratteri, usata per
# cifrare/firmare il cookie di sessione. Generane una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REGISTRAZIONI_PASSWORD=
SESSION_SECRET=

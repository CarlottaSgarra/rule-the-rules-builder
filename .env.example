# PostHog analytics (https://posthog.com)
# Project Settings -> Project API Key / Project API Host in your PostHog account.
# Set these as real values in Vercel (Project Settings -> Environment Variables),
# and/or in a local ".env.local" file (gitignored) for local dev. Never commit
# real values to this file.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
